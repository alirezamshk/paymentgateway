# Brand name shown on the payment page and admin panel (white-label).
APP_NAME="Tech-Kala Payments"
# production | staging | local
APP_ENV=production
# Generate with: php artisan key:generate  (encrypts client secrets & merchant credentials - BACK IT UP)
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
# Must be the public HTTPS origin. Used to build payment-page and PSP callback URLs.
APP_URL=https://tech-kala.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Comma separated IPs/CIDRs of your reverse proxy / load balancer (needed for HTTPS detection & client IPs).
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=techkala_payments
DB_USERNAME=techkala_payments
DB_PASSWORD=

# Admin panel sessions
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

QUEUE_CONNECTION=redis
# true on cPanel/shared hosting without Supervisor: cron runs the queue worker every minute
QUEUE_WORK_VIA_SCHEDULER=false
CACHE_STORE=redis
CACHE_PREFIX=tkpay_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# --- Payment service ---------------------------------------------------------
# Allowed clock skew for X-Timestamp (seconds)
PAYMENTS_AUTH_TIMESTAMP_TOLERANCE=300
# Cache store for nonce replay protection (must be shared by all app servers)
PAYMENTS_NONCE_STORE=redis
PAYMENTS_RATE_LIMIT_PER_MINUTE=120
PAYMENTS_IP_RATE_LIMIT_PER_MINUTE=300
# IRR (Rial) or IRT (Toman) - used when a request omits "currency"
PAYMENTS_DEFAULT_CURRENCY=IRR
PAYMENTS_TTL_MINUTES=60
PAYMENTS_STALE_VERIFICATION_SECONDS=120
# Never true in production
PAYMENTS_ALLOW_INSECURE_URLS=false

WEBHOOK_QUEUE=webhooks
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_BASE=30
WEBHOOK_BACKOFF_MAX=21600
WEBHOOK_BLOCK_PRIVATE_NETWORKS=true
# Webhook header names: {prefix}Event, {prefix}Delivery-Id, {prefix}Timestamp, {prefix}Signature
WEBHOOK_HEADER_PREFIX=X-Webhook-
WEBHOOK_USER_AGENT=PaymentService-Webhooks/1.0

GATEWAY_HTTP_TIMEOUT=20
GATEWAY_HTTP_CONNECT_TIMEOUT=10
# Internal fake PSP - local/staging only. Ignored when APP_ENV=production.
GATEWAY_SANDBOX_ENABLED=false
